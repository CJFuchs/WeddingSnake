<title>Pixel Snake</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=Sora:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap">
<style>
  :root{
    --bg:#12151a;
    --surface:#1b2027;
    --surface-2:#232a32;
    --ink:#eef1f3;
    --ink-soft:#8f9ba5;
    --snake:#7fe09a;
    --snake-head:#b4f3c3;
    --food:#ff8f66;
    --grid-line: rgba(255,255,255,0.05);
    --danger:#ff6b6b;
    --radius:10px;
  }
  *{ box-sizing:border-box; }
  html,body{ height:100%; }
  body{
    margin:0;
    background:
      radial-gradient(ellipse at 50% -10%, #1c2430 0%, var(--bg) 55%);
    color:var(--ink);
    font-family:'Sora', system-ui, sans-serif;
    display:flex;
    align-items:center;
    justify-content:center;
    min-height:100vh;
    padding:2rem 1rem;
  }
  .mono{ font-family:'JetBrains Mono', ui-monospace, monospace; font-variant-numeric:tabular-nums; }
  .pixel{ font-family:'Press Start 2P', monospace; }

  .wrap{ width:100%; max-width:30rem; }

  .titlebar{ display:flex; align-items:baseline; justify-content:space-between; margin-bottom:1rem; gap:1rem; flex-wrap:wrap; }
  .titlebar h1{
    font-family:'Press Start 2P', monospace; font-size:1.1rem; margin:0; color:var(--snake);
    text-shadow: 0 0 18px rgba(127,224,154,0.45);
    letter-spacing:.02em;
  }
  .titlebar p{ margin:.4rem 0 0; color:var(--ink-soft); font-size:.85rem; }

  .hud{
    display:flex; justify-content:space-between; align-items:center; gap:1rem;
    background:var(--surface); border:1px solid rgba(255,255,255,0.06); border-radius:var(--radius);
    padding:.9rem 1.1rem; margin-bottom:.9rem;
  }
  .hud .stat{ display:flex; flex-direction:column; gap:.2rem; }
  .hud .stat span:first-child{ font-size:.65rem; text-transform:uppercase; letter-spacing:.12em; color:var(--ink-soft); }
  .hud .stat span:last-child{ font-size:1.2rem; font-weight:600; }
  .hud .stat.score span:last-child{ color:var(--snake); }
  .hud .stat.best span:last-child{ color:var(--food); }
  .pause-btn{
    background:var(--surface-2); color:var(--ink); border:1px solid rgba(255,255,255,0.08);
    border-radius:8px; padding:.6rem .9rem; font-family:'Sora'; font-size:.8rem; cursor:pointer;
  }
  .pause-btn:hover{ border-color:var(--snake); color:var(--snake); }

  .board-frame{
    position:relative; border-radius:var(--radius); overflow:hidden;
    background:#0c0f12;
    border:1px solid rgba(255,255,255,0.07);
    box-shadow: 0 30px 60px -30px rgba(0,0,0,0.7), inset 0 0 0 1px rgba(127,224,154,0.04);
  }
  .board-frame::after{
    content:""; position:absolute; inset:0; pointer-events:none;
    background: repeating-linear-gradient(to bottom, rgba(255,255,255,0.025) 0px, rgba(255,255,255,0.025) 1px, transparent 1px, transparent 3px);
    mix-blend-mode:overlay;
  }
  canvas{ display:block; width:100%; height:auto; touch-action:none; }

  .overlay{
    position:absolute; inset:0; display:none; align-items:center; justify-content:center; flex-direction:column; gap:.9rem;
    background:rgba(12,15,18,0.86); text-align:center; padding:1.5rem;
  }
  .overlay.show{ display:flex; }
  .overlay h2{ font-family:'Press Start 2P', monospace; font-size:1rem; margin:0; color:var(--ink); }
  .overlay h2.danger{ color:var(--danger); }
  .overlay p{ margin:0; color:var(--ink-soft); font-size:.85rem; max-width:20rem; line-height:1.6; }
  .overlay .score-line{ font-family:'JetBrains Mono'; color:var(--snake); font-size:1rem; }
  .start-btn{
    margin-top:.4rem; background:var(--snake); color:#0c1a0f; border:none; border-radius:30px;
    padding:.8rem 1.8rem; font-family:'Sora'; font-weight:700; font-size:.9rem; cursor:pointer;
  }
  .start-btn:hover{ filter:brightness(1.08); }

  .controls-hint{
    margin-top:1rem; display:flex; justify-content:space-between; align-items:center; gap:1rem;
    color:var(--ink-soft); font-size:.78rem; flex-wrap:wrap;
  }
  .keys{ display:inline-flex; gap:.3rem; }
  kbd{
    font-family:'JetBrains Mono'; font-size:.72rem; background:var(--surface-2); color:var(--ink);
    border:1px solid rgba(255,255,255,0.1); border-bottom-width:2px; border-radius:5px; padding:.15rem .4rem;
  }
  :focus-visible{ outline:2px solid var(--snake); outline-offset:3px; }
  @media (prefers-reduced-motion: reduce){ *{ transition-duration:.001ms !important; } }
</style>

<div class="wrap">
  <div class="titlebar">
    <div>
      <h1>SNAKE</h1>
      <p>Arrow keys or swipe. Eat the dot, don't eat yourself.</p>
    </div>
  </div>

  <div class="hud">
    <div class="stat score"><span>Score</span><span class="mono" id="score">0</span></div>
    <div class="stat best"><span>Best</span><span class="mono" id="best">0</span></div>
    <button class="pause-btn" id="pauseBtn" type="button">Pause</button>
  </div>

  <div class="board-frame" id="boardFrame">
    <canvas id="board" width="400" height="400" role="img" aria-label="Snake game board"></canvas>

    <div class="overlay show" id="startOverlay">
      <h2 class="pixel">READY?</h2>
      <p>Guide the snake to the dots. Each one makes you longer — and a little faster. Hitting a wall or yourself ends the run.</p>
      <button class="start-btn" id="startBtn" type="button">Start game</button>
    </div>

    <div class="overlay" id="overOverlay">
      <h2 class="pixel danger">GAME OVER</h2>
      <p class="score-line">Score <span id="finalScore">0</span> · Best <span id="finalBest">0</span></p>
      <button class="start-btn" id="retryBtn" type="button">Play again</button>
    </div>

    <div class="overlay" id="pauseOverlay">
      <h2 class="pixel">PAUSED</h2>
      <button class="start-btn" id="resumeBtn" type="button">Resume</button>
    </div>
  </div>

  <div class="controls-hint">
    <span class="keys"><kbd>↑</kbd><kbd>↓</kbd><kbd>←</kbd><kbd>→</kbd> or <kbd>W</kbd><kbd>A</kbd><kbd>S</kbd><kbd>D</kbd> to move</span>
    <span><kbd>Space</kbd> to pause</span>
  </div>
</div>

<script>
(function(){
  var GRID = 20;
  var canvas = document.getElementById('board');
  var ctx = canvas.getContext('2d');
  var scoreEl = document.getElementById('score');
  var bestEl = document.getElementById('best');
  var finalScoreEl = document.getElementById('finalScore');
  var finalBestEl = document.getElementById('finalBest');
  var startOverlay = document.getElementById('startOverlay');
  var overOverlay = document.getElementById('overOverlay');
  var pauseOverlay = document.getElementById('pauseOverlay');
  var pauseBtn = document.getElementById('pauseBtn');

  var dpr = Math.min(window.devicePixelRatio || 1, 2);
  function sizeCanvas(){
    var cssSize = canvas.clientWidth || 400;
    canvas.width = cssSize * dpr;
    canvas.height = cssSize * dpr;
  }

  var best = 0;
  try{
    var stored = localStorage.getItem('pixelSnakeBest');
    if(stored) best = parseInt(stored, 10) || 0;
  }catch(e){}
  bestEl.textContent = best;

  var snake, dir, nextDir, food, score, speedMs, running, paused, loopHandle, lastTick;

  function reset(){
    var mid = Math.floor(GRID/2);
    snake = [ {x:mid-1,y:mid}, {x:mid-2,y:mid}, {x:mid-3,y:mid} ];
    dir = {x:1,y:0};
    nextDir = {x:1,y:0};
    score = 0;
    speedMs = 140;
    scoreEl.textContent = '0';
    placeFood();
  }

  function placeFood(){
    var cell;
    do{
      cell = { x: Math.floor(Math.random()*GRID), y: Math.floor(Math.random()*GRID) };
    } while(snake.some(function(s){ return s.x===cell.x && s.y===cell.y; }));
    food = cell;
  }

  function draw(){
    var size = canvas.width;
    var cell = size / GRID;
    ctx.clearRect(0,0,size,size);

    ctx.fillStyle = '#0c0f12';
    ctx.fillRect(0,0,size,size);

    ctx.strokeStyle = getComputedStyle(document.documentElement).getPropertyValue('--grid-line').trim() || 'rgba(255,255,255,0.05)';
    ctx.lineWidth = 1;
    for(var i=1;i<GRID;i++){
      ctx.beginPath(); ctx.moveTo(i*cell,0); ctx.lineTo(i*cell,size); ctx.stroke();
      ctx.beginPath(); ctx.moveTo(0,i*cell); ctx.lineTo(size,i*cell); ctx.stroke();
    }

    // food
    var fx = food.x*cell + cell/2, fy = food.y*cell + cell/2;
    ctx.fillStyle = '#ff8f66';
    ctx.beginPath();
    ctx.arc(fx, fy, cell*0.32, 0, Math.PI*2);
    ctx.fill();
    ctx.fillStyle = 'rgba(255,143,102,0.25)';
    ctx.beginPath();
    ctx.arc(fx, fy, cell*0.55, 0, Math.PI*2);
    ctx.fill();

    // snake
    for(var j=0;j<snake.length;j++){
      var s = snake[j];
      var pad = cell*0.09;
      ctx.fillStyle = j===0 ? '#b4f3c3' : '#7fe09a';
      roundRect(ctx, s.x*cell+pad, s.y*cell+pad, cell-pad*2, cell-pad*2, cell*0.22);
      ctx.fill();
    }
  }

  function roundRect(ctx,x,y,w,h,r){
    ctx.beginPath();
    ctx.moveTo(x+r,y);
    ctx.arcTo(x+w,y,x+w,y+h,r);
    ctx.arcTo(x+w,y+h,x,y+h,r);
    ctx.arcTo(x,y+h,x,y,r);
    ctx.arcTo(x,y,x+w,y,r);
    ctx.closePath();
  }

  function step(){
    dir = nextDir;
    var head = { x: snake[0].x + dir.x, y: snake[0].y + dir.y };

    if(head.x < 0 || head.y < 0 || head.x >= GRID || head.y >= GRID || snake.some(function(s){return s.x===head.x && s.y===head.y;})){
      gameOver();
      return;
    }

    snake.unshift(head);

    if(head.x === food.x && head.y === food.y){
      score += 10;
      scoreEl.textContent = score;
      if(score > best){ best = score; bestEl.textContent = best; try{ localStorage.setItem('pixelSnakeBest', String(best)); }catch(e){} }
      if(speedMs > 70 && score % 50 === 0){ speedMs -= 8; }
      placeFood();
    } else {
      snake.pop();
    }

    draw();
  }

  function loop(ts){
    if(!running || paused) return;
    if(!lastTick) lastTick = ts;
    if(ts - lastTick >= speedMs){
      lastTick = ts;
      step();
    }
    loopHandle = requestAnimationFrame(loop);
  }

  function gameOver(){
    running = false;
    finalScoreEl.textContent = score;
    finalBestEl.textContent = best;
    overOverlay.classList.add('show');
    cancelAnimationFrame(loopHandle);
  }

  function startGame(){
    reset();
    running = true;
    paused = false;
    lastTick = 0;
    startOverlay.classList.remove('show');
    overOverlay.classList.remove('show');
    pauseOverlay.classList.remove('show');
    pauseBtn.textContent = 'Pause';
    draw();
    cancelAnimationFrame(loopHandle);
    loopHandle = requestAnimationFrame(loop);
  }

  function togglePause(){
    if(!running) return;
    paused = !paused;
    pauseOverlay.classList.toggle('show', paused);
    pauseBtn.textContent = paused ? 'Resume' : 'Pause';
    if(!paused){
      lastTick = 0;
      loopHandle = requestAnimationFrame(loop);
    }
  }

  var KEY_DIRS = {
    ArrowUp:{x:0,y:-1}, ArrowDown:{x:0,y:1}, ArrowLeft:{x:-1,y:0}, ArrowRight:{x:1,y:0},
    w:{x:0,y:-1}, s:{x:0,y:1}, a:{x:-1,y:0}, d:{x:1,y:0},
    W:{x:0,y:-1}, S:{x:0,y:1}, A:{x:-1,y:0}, D:{x:1,y:0}
  };

  window.addEventListener('keydown', function(e){
    if(e.key === ' '){ e.preventDefault(); if(running) togglePause(); return; }
    if(e.key === 'Enter'){
      if(!running) startGame();
      return;
    }
    var nd = KEY_DIRS[e.key];
    if(nd && running && !paused){
      if(nd.x === -dir.x && nd.y === -dir.y) return; // no instant reverse
      nextDir = nd;
      e.preventDefault();
    }
  });

  // touch swipe controls
  var touchStart = null;
  canvas.addEventListener('touchstart', function(e){
    var t = e.changedTouches[0];
    touchStart = {x:t.clientX, y:t.clientY};
  }, {passive:true});
  canvas.addEventListener('touchend', function(e){
    if(!touchStart || !running || paused) return;
    var t = e.changedTouches[0];
    var dx = t.clientX - touchStart.x, dy = t.clientY - touchStart.y;
    var nd;
    if(Math.abs(dx) > Math.abs(dy)){
      nd = dx > 0 ? {x:1,y:0} : {x:-1,y:0};
    } else {
      nd = dy > 0 ? {x:0,y:1} : {x:0,y:-1};
    }
    if(!(nd.x === -dir.x && nd.y === -dir.y)) nextDir = nd;
    touchStart = null;
  }, {passive:true});

  document.getElementById('startBtn').addEventListener('click', startGame);
  document.getElementById('retryBtn').addEventListener('click', startGame);
  document.getElementById('resumeBtn').addEventListener('click', togglePause);
  pauseBtn.addEventListener('click', togglePause);

  window.addEventListener('resize', function(){ sizeCanvas(); draw(); });
  sizeCanvas();
  reset();
  draw();
})();
</script>
